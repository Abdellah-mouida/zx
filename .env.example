# ZEROOX — environment template
# Copy to .env and fill in. NEVER commit .env.
# Keys without the VITE_ prefix stay server-side only (Vercel / Worker env).

# --- Contact form delivery (Resend) --------------------------------
# Server-side only. Obtain at https://resend.com/api-keys
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxx
# Verified sender domain on Resend, e.g. "ZEROOX <transmit@zeroox.dev>"
CONTACT_FROM="ZEROOX <transmit@zeroox.dev>"
# Where transmissions are delivered
CONTACT_TO=contact@zeroox.dev

# --- Cloudflare Turnstile (spam protection) -----------------------
# Public site key — safe to expose, injected at build time
VITE_TURNSTILE_SITE_KEY=0x4AAAAAAAxxxxxxxxxxxxxx
# Secret key — server-side ONLY, used for siteverify
TURNSTILE_SECRET_KEY=0x4AAAAAAAxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# --- Optional -----------------------------------------------------
# Public site origin, used for canonical URLs and OG tags
VITE_SITE_URL=https://zeroox.dev
